# Copia este archivo a ".env" (sin ".example") y completa tus valores reales.
# El archivo .env no se sube a git (ver .gitignore).
GEMINI_API_KEY=tu_clave_de_gemini_aca

# Postgres (Neon). La misma base se usa en desarrollo local y en produccion.
DATABASE_URL=postgresql://usuario:password@host/db?sslmode=require

# Clave para firmar la cookie de sesion en produccion (Render). En local, si
# se deja vacia, se genera y guarda sola en backend/.session_secret.
SESSION_SECRET=

# Client ID de OAuth de Google Cloud Console (el mismo valor que
# frontend/.env.example: VITE_GOOGLE_CLIENT_ID), para verificar el token que
# manda el boton "Continuar con Google".
GOOGLE_CLIENT_ID=

# API key de Resend (https://resend.com) para mandar por mail los mensajes
# del boton "Ayuda" y las alertas de umbral de "Mi flota". Si se deja vacia,
# los mensajes de ayuda igual quedan guardados en la tabla mensajes_ayuda y
# las alertas quedan registradas en alertas_notificadas con el error, solo
# que no sale el mail.
RESEND_API_KEY=

# Remitente de los mails. OJO: sin un dominio propio verificado en Resend, el
# dominio de prueba (onboarding@resend.dev) SOLO entrega al mail de la cuenta
# que creo la API key. Hasta verificar un dominio propio y ponerlo aca, las
# alertas dirigidas a otros usuarios se van a rechazar con un 403.
# El dominio de esta direccion tiene que ser el mismo que se verifico.
# MAIL_REMITENTE=AlgoRio <alertas@mail.tudominio.com>

# A donde llegan los mensajes del boton "Ayuda". Si se deja vacia se usa la
# casilla historica de soporte.
# MAIL_SOPORTE=soporte@tudominio.com

# A donde apunta el link de "olvide mi contraseña" que va en el mail. Son dos
# webs sobre el mismo backend y el rol de la cuenta decide cual: un naviera
# mandado a app.algorio cae en la pantalla que le dice que su cuenta es del
# otro producto, justo cuando no puede entrar a ninguno. Los valores de abajo
# son los de produccion; en desarrollo conviene apuntarlos al Vite local para
# poder probar el circuito entero.
# URL_APP=http://localhost:5173
# URL_PRO=http://localhost:5173

# Duracion de la prueba gratis, en dias (por defecto 14). Poner 0 para
# probar como se ve la app con la suscripcion vencida. No afecta al perfil
# recreativo, que es gratis y no vence.
# DIAS_PRUEBA=14

# Origenes que pueden llamar a la API desde un navegador, separados por coma.
# La web de produccion NO necesita estar aca: llama a /api relativo y Vercel lo
# reescribe al backend, asi que para el navegador es el mismo origen. Esto es
# para la app movil corrida con `expo start --web` durante desarrollo (React
# Native no aplica CORS: no es un navegador).
# ORIGENES_CORS=http://localhost:8081,http://localhost:19006,http://localhost:5173


# Opcional: solo si queres forzar modelos distintos a los de por defecto.
# GEMINI_MODELO_PRINCIPAL=gemini-3.5-flash-lite
# GEMINI_MODELO_RESPALDO=gemini-flash-latest

# Clave de aisstream.io (https://aisstream.io) para el trafico de
# embarcaciones en tiempo real del mapa del nauta. Si se deja vacia, la capa
# de barcos simplemente no aparece y el resto del mapa funciona igual.
#
# NUNCA en el frontend: aisstream la manda dentro del mensaje de suscripcion
# del WebSocket, asi que un cliente que se conectara directo la expondria.
AISSTREAM_API_KEY=

# --- Fotos de los comercios (opcional) -------------------------------------
#
# Sin esto las fotos se guardan en Postgres y se sirven desde /api/fotos/{id}:
# funciona, no hay que crear ninguna cuenta, y con el plan free de Neon (0,5 GB)
# entran unas 1.900 fotos.
#
# Con esto van a Cloudinary, que da 25 GB gratis y —lo que de verdad importa—
# las entrega desde un CDN, asi que se ven aunque Render este dormido. Ademas
# convierte a WebP y ajusta calidad sola.
#
# Como sacarlas: crear una cuenta gratis en cloudinary.com, copiar el "Cloud
# name" del panel, y en Settings > Upload crear un "upload preset" en modo
# UNSIGNED. Conviene limitarle carpeta, tamaño maximo y formatos: al ser sin
# firmar, cualquiera que sepa el nombre del preset puede subir a esa cuenta.
#
# No hace falta migrar nada al activarlo: las fotos viejas siguen sirviendose
# desde la base y las nuevas van a Cloudinary.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_UPLOAD_PRESET=
