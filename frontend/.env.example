# Copia este archivo a ".env" (sin ".example") para desarrollo local.
# El archivo .env no se sube a git (ver .gitignore).

# Client ID de Google Cloud Console (OAuth) para el boton "Continuar con
# Google" en Login/Registro. Si se deja vacio, el boton simplemente no se
# muestra (ver frontend/src/components/BotonGoogle.jsx).
VITE_GOOGLE_CLIENT_ID=
